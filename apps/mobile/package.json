{
  "name": "@pforum/mobile",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "PeerForum mobile shell (Capacitor) for Android and iOS",
  "scripts": {
    "sync": "npm -w @pforum/web run build && cap sync",
    "add:android": "cap add android",
    "add:ios": "cap add ios",
    "open:android": "cap open android",
    "open:ios": "cap open ios",
    "build:android": "npm run sync && cap build android",
    "build:ios": "npm run sync && cap build ios"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.2"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/ios": "^8.5.2"
  }
}
