{
  "name": "@pforum/mobile",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "PeerForum mobile shell (Capacitor) for Android and iOS",
  "scripts": {
    "build:node": "node scripts/build-node.mjs",
    "test:node18": "node scripts/node18-check.mjs",
    "copy:node": "node scripts/copy-node.mjs",
    "build:web": "npm -w @pforum/web run build",
    "patch:android": "node scripts/patch-android.mjs",
    "sync": "npm run build:web && npm run build:node && npm run copy:node && cap sync && npm run patch:android",
    "add:android": "cap add android",
    "add:ios": "cap add ios",
    "open:android": "cap open android",
    "open:ios": "cap open ios",
    "build:android": "npm run sync && cap build android",
    "build:ios": "npm run sync && cap build ios",
    "android": "node scripts/android.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "@capawesome/capacitor-nodejs": "^0.1.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/ios": "^8.5.2"
  }
}
